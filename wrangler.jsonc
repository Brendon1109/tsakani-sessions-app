// The Cloudflare Worker for tsakanisessions.co.za, built with OpenNext.
// Production since 24 September 2026. Settings, secrets and checks are in
// docs/CLOUDFLARE-MOVE.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsakani-sessions-app",
  // Brendon's personal Cloudflare account. Never another account.
  "account_id": "def57486f42c3f50263d4ae8edf11cd0",
  // A thin wrapper around OpenNext's generated worker that adds the nightly
  // cron. It imports .open-next/worker.js, so it only bundles after
  // `npx opennextjs-cloudflare build`.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image goes through Cloudflare Images. Without this binding OpenNext
  // would proxy full size originals through the Worker. See the runbook for
  // the free allowance.
  "images": {
    "binding": "IMAGES"
  },
  // The two nightly jobs, cleanup-orders and finalize-events, both at 03:00
  // UTC. custom-worker.ts runs both from this one trigger.
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  // Declared here rather than in the dashboard so it ships with the code.
  // app/api/e/route.ts reads it to decide which edge headers to trust, and
  // its upstream copy still defaults to vercel when it is unset. Do not also
  // set it as a secret.
  "vars": {
    "BZ_PLATFORM": "cloudflare"
  },
  // The workers.dev address stays on as a second way in for checks. If it is
  // ever switched off, drop its Supabase redirect URL too (runbook step 12).
  "workers_dev": true,
  // No per version preview hostnames. The admin screens and the cron routes
  // sit behind this Worker, so every version should not get its own address.
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  }
  // The apex and www are Custom Domains, added in the dashboard at cutover on
  // 24 September 2026. Moving them into "routes" here is runbook step 10,
  // still to do.
}
