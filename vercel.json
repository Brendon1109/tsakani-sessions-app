{
  "crons": [
    {
      "path": "/api/cron/cleanup-orders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/finalize-events",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.tsakanisessions.co.za"
        }
      ],
      "destination": "https://tsakanisessions.co.za/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.tsakanisessions.co.za"
        }
      ],
      "destination": "https://tsakanisessions.co.za/:path+",
      "permanent": true
    }
  ]
}
