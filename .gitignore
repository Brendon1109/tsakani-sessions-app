# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# Claude Code machine-local settings — holds the Supabase personal access token
# (sbp_...), which is an ACCOUNT-level credential covering every organisation.
# .claude/settings.json (shared, no secrets) stays committable; this one never is.
.claude/settings.local.json

# vercel
.vercel

# cloudflare workers (OpenNext build output, wrangler state, local secrets)
/.open-next/
/.wrangler/
/dist-dryrun/
.dev.vars*

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc
scripts/client_secret.json
scripts/youtube_token.json
scripts/footage/
scripts/output/
scripts/temp_merge/
venv/

# supabase
supabase/.temp/

# signup exports — personal data (POPIA), never commit
signups-*.csv
supabase/.branches/

.vercel
