# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tsakani Sessions

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=27769961477

# Email — REQUIRED for ticket confirmations
# Without RESEND_API_KEY the app still takes orders and shows the confirmation
# screen, but no confirmation email is sent and buyers leave with only what they
# managed to screenshot. Set it.
# RESEND_FROM_EMAIL must be on a domain verified in Resend, or mail lands in spam.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Tsakani Sessions <hello@tsakanisessions.co.za>
# ADMIN_EMAIL=tsakanisessions@gmail.com

# Analytics
# First-party analytics is built in (no third-party scripts). It writes to the
# analytics_events table via /api/track and is read by /admin/analytics.
# Set to "true" to disable all client-side tracking (e.g. for staging).
# NEXT_PUBLIC_ANALYTICS_DISABLED=false
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
